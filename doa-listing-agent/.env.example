# ─────────────────────────────────────────────────────────────
# DOA Listing Agent — Environment Variables Template
# ─────────────────────────────────────────────────────────────
# INSTRUCTIONS:
#   1. Copy this file and rename the copy to ".env"
#   2. Fill in all values below with your real credentials
#   3. NEVER commit .env to git — it contains secrets!
# ─────────────────────────────────────────────────────────────

# ── Supabase Database ─────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://mwspcagajlkanpfdbuqc.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Supabase Login (for row-level security) ───────────────────
# Your personal Supabase account login (or a service account)
SUPABASE_EMAIL=your_email@example.com
SUPABASE_PASSWORD=your_supabase_password_here

# ── Denver Online Auctions Sub-Admin Login ────────────────────
# Your login for denveronlineauctions.com/sub-admin/
DOA_EMAIL=your_doa_email@example.com
DOA_PASSWORD=your_doa_password_here

# ── DOA Auction Settings ──────────────────────────────────────
# Auction slug: the part of your auction URL after /auction/
# Example URL: https://denveronlineauctions.com/auction/175-oz-silver-exgle-vintage-collectibles-china
#                                                        ↑ this part is the slug
DOA_AUCTION_SLUG=175-oz-silver-exgle-vintage-collectibles-china

# Base URL (do not include trailing slash)
DOA_BASE_URL=https://denveronlineauctions.com

# ── Scheduler (cron expression) ───────────────────────────────
# Default: 8:00am every day
# Format: minute hour day-of-month month day-of-week
# Examples:
#   0 8 * * *     = 8am daily
#   0 */4 * * *   = every 4 hours
#   0 8 * * 1-5   = 8am weekdays only
#   */30 * * * *  = every 30 minutes (for testing)
# Use https://crontab.guru to build your own
SCHEDULE_TIME=0 8 * * *

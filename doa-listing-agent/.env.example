# ─────────────────────────────────────────────────────────────────────────────
# DOA Listing Agent — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains your passwords.
# ─────────────────────────────────────────────────────────────────────────────

# ── DOA Credentials (required for all modes) ──────────────────────────────────

# Your Denver Online Auctions sub-admin login credentials
DOA_EMAIL=your-email@example.com
DOA_PASSWORD=your-doa-password

# The URL of the FIRST lot's EditAuction page for this auction batch.
# The agent starts here and uses "Save & Edit Next" to move through the lots.
# Find this by opening the first lot in DOA sub-admin and copying the URL.
# NOTE: In --supabase --batch mode this is pulled from the database automatically
#       if it was saved in Vendor-Zen-Tool. Still good to have as a fallback.
DOA_FIRST_LOT_URL=https://denveronlineauctions.com/sub-admin/EditAuction?id=1234567&PartyId=115

# ── Supabase / Vendor-Zen-Tool (required for --supabase and --watch modes) ────
#
# Connects the agent directly to your Vendor-Zen-Tool database so it can pull
# pending lots automatically — no CSV export needed.
#
# SUPABASE_URL: Found in Supabase Dashboard → Settings → API → Project URL
# SUPABASE_SERVICE_ROLE_KEY: Found in Supabase Dashboard → Settings → API → service_role
#   ⚠️ This key bypasses Row-Level Security — keep it secret, server-only.

SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# ── Scheduler (optional — only needed if using node scheduler.js) ─────────────

# Full path to the CSV file the scheduler should process on each run
# SCHEDULE_CSV=C:\Users\david\auctions\my-lots.csv

# When to run (cron format). Default: 8:00am every day.
# See https://crontab.guru for help.
# SCHEDULE_TIME=0 8 * * *

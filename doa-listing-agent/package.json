{
  "name": "doa-listing-agent",
  "version": "3.0.0",
  "description": "Automated lot listing agent for Denver Online Auctions — zip-based image upload with AI title/description generation",
  "type": "module",
  "main": "agent.js",
  "scripts": {
    "start":    "node agent.js",
    "zip":      "node agent.js --zip",
    "dry-run":  "node agent.js --dry-run",
    "inspect":  "node inspect-form.js"
  },
  "dependencies": {
    "@supabase/supabase-js":            "^2.49.0",
    "adm-zip":                          "^0.5.10",
    "axios":                            "^1.6.0",
    "chalk":                            "^5.3.0",
    "dotenv":                           "^16.3.0",
    "node-cron":                        "^3.0.3",
    "playwright":                       "npm:rebrowser-playwright@^1.42.0",
    "playwright-core":                  "npm:rebrowser-playwright-core@^1.42.0",
    "playwright-extra":                 "^4.3.6",
    "puppeteer-extra-plugin-stealth":   "^2.11.2"
  }
}

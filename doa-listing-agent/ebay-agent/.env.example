# ── eBay Credentials ──────────────────────────────────────────────────────────
EBAY_EMAIL=your@email.com
EBAY_PASSWORD=yourpassword

# ── Queue Folder ──────────────────────────────────────────────────────────────
# Drop CSVs downloaded from the app into this folder.
# The agent picks up the newest CSV, uploads it, then renames it DONE- when finished.
EBAY_CSV_QUEUE_DIR=C:\Users\david\Desktop\eBay CSV

# ── Schedule ──────────────────────────────────────────────────────────────────
# Cron expression for when to auto-upload. Use https://crontab.guru to build one.
# Examples:
#   "0 20 * * *"    = 8pm every night
#   "0 9 * * 6"     = 9am every Saturday
#   "0 8,20 * * *"  = 8am and 8pm every day
SCHEDULE_TIME=0 20 * * *

# ── Upload Limits ─────────────────────────────────────────────────────────────
# Max number of CSV files to upload per run (prevents flooding eBay)
MAX_UPLOADS_PER_RUN=2

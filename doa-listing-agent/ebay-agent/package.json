{
  "name": "ebay-csv-agent",
  "version": "1.0.0",
  "description": "Watches a local folder for eBay CSV files and uploads them to Seller Hub automatically",
  "type": "module",
  "main": "agent.js",
  "scripts": {
    "start": "node agent.js --schedule",
    "run-once": "node agent.js",
    "dry-run": "node agent.js --dry-run"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "dotenv": "^16.3.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.4",
    "playwright": "^1.41.0"
  }
}

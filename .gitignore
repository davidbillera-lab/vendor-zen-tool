.env

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Agent scratch (brainstorm sessions, not project source)
.superpowers/
.codex-qc/

# Agent runtime state — not source
*.progress.json
*.lnk

# Supabase CLI temp files — generated, not source
supabase/.temp/

# Local MCP server config — machine-specific
.mcp.json
.vercel

# EstateSales local test credentials + captured session (treat as credentials)
estatesales-agent/.estatesales-test.env
estatesales-agent/es-session.json
estatesales-agent/es-cookies.json
# Persistent local Chrome profile for the agent — contains cookies/session data
estatesales-agent/.chrome-profile/
# Run artifacts — screenshots can show a logged-in account; logs are noise
estatesales-agent/screenshots/
estatesales-agent/*.out
estatesales-agent/smoke-run-*.log

# Local image/scratch artifacts — large binaries + captures, not source
screenshots/
doa-listing-agent/*.zip
.codex-qc/
